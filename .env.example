# ==============================================
# HAUXHAUX Sistema de Gestão - Variáveis de Ambiente
# ==============================================
# Copie este arquivo para .env.local e preencha os valores

# ---- Banco de Dados (PostgreSQL / Neon) ----
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ---- NextAuth.js ----
# Secret usado para assinar tokens JWT (gere um novo com: openssl rand -base64 32)
NEXTAUTH_SECRET="gere-um-secret-seguro-aqui"

# URL pública do sistema (ajuste para o domínio final)
NEXTAUTH_URL="https://gestao.hauxhaux.com.br"
